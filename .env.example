# Product Explorer: environment variables.
#
# This file is optional. docker-compose.yml has the same local defaults, so
# "docker compose up" works without a .env file. Copy this file to .env only
# to change a value. These are local development values, not secrets: never
# reuse them outside your machine.

# Database user.
POSTGRES_USER=product_explorer
# Database password (local only).
POSTGRES_PASSWORD=product_explorer
# Database name.
POSTGRES_DB=product_explorer

# SQLAlchemy URL used by the backend. Leave it commented out to have it
# built from the three values above; set it only to use another database.
# DATABASE_URL=postgresql+psycopg://product_explorer:product_explorer@db:5432/product_explorer

# Base URL of the Fake Store API, the source of the product import.
FAKESTORE_BASE_URL=https://fakestoreapi.com
# Timeout of each request to Fake Store, in seconds.
FAKESTORE_TIMEOUT_SECONDS=5
# Number of retries after the first failed request to Fake Store.
FAKESTORE_MAX_RETRIES=2

# Directory inside the backend container where product images are stored.
IMAGES_DIR=/data/images
# Log level of the backend (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
# true: the backend container applies the migrations and imports the
# catalogue (when empty) before starting the API. false: it only starts
# the API, and the migrations and the import run as one-off jobs
# ("docker compose run --rm backend migrate", then "... backend seed"), as
# in docker-compose.prod.yml.
RUN_STARTUP_TASKS=true

# Host port of the web application: http://localhost:8080
FRONTEND_PORT=8080
# Host port of the API, published on 127.0.0.1 only.
BACKEND_PORT=8000
